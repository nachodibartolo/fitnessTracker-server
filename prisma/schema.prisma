generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String?    @unique
  passwordHash       String?
  name               String?
  timezone           String     @default("America/Argentina/Buenos_Aires")
  weightUnit         WeightUnit @default(KG)
  heightCm           Float?
  birthDate          DateTime?  @db.Date
  dailyKcalTarget    Int?
  dailyProteinTarget Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  healthImports    HealthImport[]
  healthSamples    HealthSample[]
  workouts         Workout[]
  dailySummaries   DailyHealthSummary[]
  meals            Meal[]
  authSessions     AuthSession[]
}

enum WeightUnit {
  KG
  LB
}

model AuthSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model HealthImport {
  id               String              @id @default(uuid(7)) @db.Uuid
  userId           String              @db.Uuid
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel          HealthImportChannel
  status           ImportStatus        @default(PENDING)
  fileName         String?
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?
  rangeFrom        DateTime?           @db.Date
  rangeTo          DateTime?           @db.Date
  daysUpserted     Int                 @default(0)
  workoutsUpserted Int                 @default(0)
  samplesInserted  Int                 @default(0)
  error            String?

  days     DailyHealthSummary[]
  workouts Workout[]
  samples  HealthSample[]
}

enum HealthImportChannel {
  APPLE_HEALTH_XML
  HEALTHKIT
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model DailyHealthSummary {
  id       String        @id @default(uuid(7)) @db.Uuid
  userId   String        @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId String?       @db.Uuid
  import   HealthImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  date     DateTime      @db.Date

  steps                Int?
  distanceKm           Float?
  flightsClimbed       Int?
  activeEnergyKcal     Float?
  basalEnergyKcal      Float?
  activeEnergyGoalKcal Float?
  exerciseMin          Int?
  standHours           Int?

  restingHeartRate Int?
  avgHeartRate     Float?
  minHeartRate     Int?
  maxHeartRate     Int?
  hrvSdnnMs        Float?
  respiratoryRate  Float?
  oxygenSaturation Float?

  sleepStartedAt DateTime?
  sleepEndedAt   DateTime?
  sleepInBedMin  Int?
  sleepAsleepMin Int?
  sleepCoreMin   Int?
  sleepDeepMin   Int?
  sleepRemMin    Int?
  sleepAwakeMin  Int?

  weightKg       Float?
  bodyFatPct     Float?
  leanBodyMassKg Float?

  manualFields String[] @default([])

  workoutCount Int @default(0)
  workoutMin   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

enum WorkoutType {
  TRADITIONAL_STRENGTH_TRAINING
  FUNCTIONAL_STRENGTH_TRAINING
  RUNNING
  WALKING
  CYCLING
  STAIR_CLIMBING
  SWIMMING
  HIIT
  OTHER
}

model Workout {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId         String?       @db.Uuid
  import           HealthImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  type             WorkoutType
  activityTypeRaw  String?
  startedAt        DateTime
  endedAt          DateTime
  durationMin      Float
  activeEnergyKcal Float?
  distanceKm       Float?
  avgHeartRate     Float?
  maxHeartRate     Int?
  isIndoor         Boolean?
  sourceName       String
  externalId       String?

  @@unique([userId, sourceName, startedAt])
  @@index([userId, startedAt])
}

enum HealthMetric {
  BODY_MASS
  BODY_FAT_PERCENTAGE
  LEAN_BODY_MASS
  BODY_MASS_INDEX
  HEIGHT
  RESTING_HEART_RATE
  HEART_RATE_VARIABILITY_SDNN
  VO2_MAX
}

model HealthSample {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importId   String?       @db.Uuid
  import     HealthImport? @relation(fields: [importId], references: [id], onDelete: Cascade)
  metric     HealthMetric
  value      Float
  measuredAt DateTime
  sourceName String
  externalId String?

  @@unique([userId, metric, sourceName, measuredAt])
  @@index([userId, metric, measuredAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  AI_IMAGE
  AI_TEXT
}

model Meal {
  id       String    @id @default(uuid(7)) @db.Uuid
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt  DateTime
  mealType MealType?
  name     String
  imageUrl String?

  calories Float?
  proteinG Float?
  carbsG   Float?
  fiberG   Float?
  fatG     Float?

  source       MealSource @default(MANUAL)
  aiModel      String?
  aiConfidence Float?
  aiRaw        Json?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MealItem[]

  @@index([userId, eatenAt])
}

model MealItem {
  id       String  @id @default(uuid(7)) @db.Uuid
  mealId   String  @db.Uuid
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  order    Int
  name     String
  quantity Float?
  unit     String?
  calories Float?
  proteinG Float?
  carbsG   Float?
  fiberG   Float?
  fatG     Float?

  @@unique([mealId, order])
}
